# systemd user unit; install-linux.sh copies it to
# ~/.config/systemd/user/ and writes the environment file it reads.
[Unit]
Description=oshirase notification daemon
Documentation=https://github.com/moroz/oshirase
# The notification service lives in the graphical session.
After=graphical-session.target

[Service]
# Written by install-linux.sh: OSHIRASE_LISTEN (loopback plus the VM bridge
# addresses found at install) and, to choose a backend other than the
# desktop's, OSHIRASE_BACKEND. %E is $XDG_CONFIG_HOME, else ~/.config.
EnvironmentFile=-%E/oshirase/env
ExecStart=%h/.local/bin/oshirase serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
